  {"title":{{ entry.title | jsonify }},"url":{{ entry.url | relative_url | jsonify }},"summary":{{ entry.summary | default: '' | jsonify }},"text":{{ entry.content | markdownify | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
