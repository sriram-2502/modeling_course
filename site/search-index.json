  {% for item in site.data.assignments %},{"title":{{ item.number | plus: 0 | prepend: 'Assignment ' | append: ' · ' | append: item.title | jsonify }},"url":{{ '/assignments/#assignment-' | append: item.number | relative_url | jsonify }},"summary":{{ item.title | jsonify }},"text":"Practice problems"}{% endfor %}
  {% for skill in site.data.skills %},{"title":{{ skill.name | jsonify }},"url":{{ skill.url | relative_url | jsonify }},"summary":{{ skill.outcome | jsonify }},"text":{{ skill.aliases | jsonify }},"keywords":{{ skill.aliases | jsonify }}}{% endfor %}
  {% for exam in site.data.exams %},{"title":{{ exam.name | append: ' study guide' | jsonify }},"url":{{ '/exams/#' | append: exam.id | relative_url | jsonify }},"summary":{{ exam.topic | jsonify }},"text":{{ exam.description | jsonify }},"keywords":{{ exam.name | downcase | jsonify }}}{% endfor %}
